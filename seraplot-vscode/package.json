{
  "name": "seraplot-vscode",
  "displayName": "SeraPlot",
  "description": "Live preview, gallery, theme studio and snippets for SeraPlot \u2014 high-performance Rust charts for Python, C# and JavaScript/TypeScript.",
  "version": "0.12.0",
  "publisher": "feur25",
  "license": "MIT",
  "icon": "logo.png",
  "homepage": "https://github.com/feur25/Sera#readme",
  "bugs": { "url": "https://github.com/feur25/Sera/issues" },
  "repository": {
    "type": "git",
    "url": "https://github.com/feur25/Sera.git",
    "directory": "seraplot-vscode"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Data Science", "Visualization", "Snippets", "Other"],
  "keywords": ["seraplot", "plot", "chart", "data", "visualization", "ml", "automl", "rust", "matplotlib", "plotly"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "seraplotActivity",
          "title": "SeraPlot",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "seraplotPanel",
          "title": "SeraPlot Preview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "seraplotActivity": [
        { "id": "seraplotHome",     "name": "Quick Actions", "type": "webview" },
        { "id": "seraplotGallery",  "name": "Chart Gallery", "type": "tree"    },
        { "id": "seraplotPreviews", "name": "Recent Files",  "type": "tree"    }
      ],
      "seraplotPanel": [
        { "id": "seraplotLivePreview", "name": "Live Preview", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "seraplot.wasmPlayground", "title": "SeraPlot: WASM Playground",            "icon": "$(play)" },
      { "command": "seraplot.preview",        "title": "SeraPlot: Live Preview",         "icon": "$(open-preview)"  },
      { "command": "seraplot.refreshPreview", "title": "SeraPlot: Refresh Preview",      "icon": "$(refresh)"       },
      { "command": "seraplot.themeStudio",    "title": "SeraPlot: Open Theme Studio",    "icon": "$(symbol-color)"  },
      { "command": "seraplot.chartStudio",    "title": "SeraPlot: Open Chart Studio",    "icon": "$(settings)"      },
      { "command": "seraplot.gallery",        "title": "SeraPlot: Open Gallery",         "icon": "$(library)"       },
      { "command": "seraplot.insertChart",    "title": "SeraPlot: Insert Chart…",        "icon": "$(symbol-snippet)" },
      { "command": "seraplot.insertConfig",   "title": "SeraPlot: Insert sp.config(…)",  "icon": "$(settings-gear)" },
      { "command": "seraplot.newDemo",        "title": "SeraPlot: New Demo File",        "icon": "$(new-file)"      },
      { "command": "seraplot.exportHtml",     "title": "SeraPlot: Export Preview as HTML" },
      { "command": "seraplot.openDocs",       "title": "SeraPlot: Open Documentation"  },
      { "command": "seraplot.checkInstall",   "title": "SeraPlot: Check Installation", "icon": "$(checklist)" },
      { "command": "seraplot.autoInstall",    "title": "SeraPlot: Install / Update SeraPlot", "icon": "$(cloud-download)" },
      { "command": "seraplot.uninstall",      "title": "SeraPlot: Uninstall SeraPlot", "icon": "$(trash)" },
      { "command": "seraplot.refreshCatalog", "title": "SeraPlot: Refresh Framework Catalog", "icon": "$(sync)" },
      { "command": "seraplot.useWheel",       "title": "SeraPlot: Drop / Use Wheel (.whl)", "icon": "$(package)" },
      { "command": "seraplot.useSystem",      "title": "SeraPlot: Use System Install (no wheel)", "icon": "$(home)" },
      { "command": "seraplot.openCatalogJson","title": "SeraPlot: Open Catalog JSON", "icon": "$(json)" },
      { "command": "seraplot.clearWheelCache","title": "SeraPlot: Clear Wheel Cache", "icon": "$(trash)" },
      { "command": "seraplot.listWheels",     "title": "SeraPlot: List Cached Wheels", "icon": "$(list-unordered)" },
      { "command": "seraplot.previewMode",    "title": "SeraPlot: Switch Preview Mode (panel → tab → window)", "icon": "$(layout)" },
      { "command": "seraplot.previewFloat",   "title": "SeraPlot: Float Preview to New Window",                  "icon": "$(multiple-windows)" },
      { "command": "seraplot.togglePreview",  "title": "SeraPlot: Toggle Live Preview",                  "icon": "$(eye)" },
      { "command": "seraplot.sysmon",         "title": "SeraPlot: Monitor System (CPU / RAM / Disk)",     "icon": "$(pulse)" },
      { "command": "seraplot.methodToggle",   "title": "SeraPlot: Method Toggle (chain builder)",          "icon": "$(symbol-method)" },
      { "command": "seraplot.toggleFavoriteChart", "title": "Toggle Favorite", "icon": "$(star-full)" },
      { "command": "seraplot.createFolder",   "title": "New Folder…", "icon": "$(new-folder)" },
      { "command": "seraplot.deleteFolder",   "title": "Delete Folder", "icon": "$(trash)" },
      { "command": "seraplot.renameFolder",   "title": "Rename Folder…", "icon": "$(edit)" },
      { "command": "seraplot.addToFolder",    "title": "Add to Folder…", "icon": "$(add)" },
      { "command": "seraplot.removeFromFolder", "title": "Remove from Folder", "icon": "$(dash)" },
      { "command": "seraplot.gallerySearch",  "title": "SeraPlot: Search Gallery", "icon": "$(search)" },
      { "command": "seraplot.clearGallerySearch", "title": "SeraPlot: Clear Gallery Search", "icon": "$(clear-all)" },
      { "command": "seraplot.keyboardShortcuts", "title": "SeraPlot: Keyboard Shortcuts", "icon": "$(keyboard)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "seraplot.preview", "group": "navigation@1", "when": "resourceLangId == python || resourceLangId == csharp || resourceLangId == javascript || resourceLangId == typescript" },
        { "command": "seraplot.wasmPlayground", "group": "navigation@2", "when": "resourceLangId == python || resourceLangId == csharp || resourceLangId == javascript || resourceLangId == typescript" },
        { "command": "seraplot.togglePreview", "group": "navigation@3", "when": "resourceLangId == python || resourceLangId == csharp || resourceLangId == javascript || resourceLangId == typescript" },
        { "command": "seraplot.previewMode", "group": "navigation@4", "when": "resourceLangId == python || resourceLangId == csharp || resourceLangId == javascript || resourceLangId == typescript" },
        { "command": "seraplot.methodToggle", "group": "navigation@5", "when": "resourceLangId == python" }
      ],
      "view/title": [
        { "command": "seraplot.refreshPreview", "when": "view == seraplotPreviews || view == seraplotLivePreview", "group": "navigation" },
        { "command": "seraplot.togglePreview",  "when": "view == seraplotLivePreview", "group": "navigation" },
        { "command": "seraplot.previewMode",    "when": "view == seraplotLivePreview", "group": "navigation" },
        { "command": "seraplot.newDemo",        "when": "view == seraplotPreviews", "group": "navigation" },
        { "command": "seraplot.gallerySearch",       "when": "view == seraplotGallery", "group": "navigation@1" },
        { "command": "seraplot.clearGallerySearch",  "when": "view == seraplotGallery", "group": "navigation@2" },
        { "command": "seraplot.createFolder",        "when": "view == seraplotGallery", "group": "navigation@3" }
      ],
      "view/item/context": [
        { "command": "seraplot.toggleFavoriteChart", "when": "view == seraplotGallery && (viewItem == chart || viewItem == variant || viewItem == folderChart || viewItem == folderVariant)", "group": "inline" },
        { "command": "seraplot.addToFolder",         "when": "view == seraplotGallery && (viewItem == chart || viewItem == variant)", "group": "1" },
        { "command": "seraplot.removeFromFolder",    "when": "view == seraplotGallery && (viewItem == folderChart || viewItem == folderVariant)", "group": "1" },
        { "command": "seraplot.renameFolder",        "when": "view == seraplotGallery && viewItem == folder", "group": "1" },
        { "command": "seraplot.deleteFolder",        "when": "view == seraplotGallery && viewItem == folder", "group": "1" }
      ],
      "explorer/context": [
        { "command": "seraplot.preview", "when": "resourceLangId == python || resourceLangId == csharp || resourceLangId == javascript || resourceLangId == typescript", "group": "navigation@9" }
      ]
    },
    "snippets": [
      { "language": "python", "path": "./snippets/python.json" }
    ],
    "keybindings": [
      { "command": "seraplot.preview", "key": "ctrl+alt+p", "mac": "cmd+alt+p", "when": "resourceLangId == python || resourceLangId == csharp || resourceLangId == javascript || resourceLangId == typescript" },
      { "command": "seraplot.refreshPreview", "key": "ctrl+alt+r", "mac": "cmd+alt+r", "when": "resourceLangId == python || resourceLangId == csharp || resourceLangId == javascript || resourceLangId == typescript" },
      { "command": "seraplot.chartStudio", "key": "ctrl+alt+s", "mac": "cmd+alt+s" },
      { "command": "seraplot.gallery", "key": "ctrl+alt+g", "mac": "cmd+alt+g" },
      { "command": "seraplot.insertChart", "key": "ctrl+alt+i", "mac": "cmd+alt+i", "when": "resourceLangId == python" },
      { "command": "seraplot.themeStudio", "key": "ctrl+alt+t", "mac": "cmd+alt+t" },
      { "command": "seraplot.keyboardShortcuts", "key": "ctrl+alt+k ctrl+alt+k", "mac": "cmd+alt+k cmd+alt+k" }
    ],
    "configuration": {
      "title": "SeraPlot",
      "properties": {
        "seraplot.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter used to render previews."
        },
        "seraplot.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Path to the Node.js executable used to render JavaScript/TypeScript previews."
        },
        "seraplot.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "description": "Path to the dotnet CLI used to render C# previews (runs `dotnet run` against the nearest .csproj)."
        },
        "seraplot.autoReload": {
          "type": "boolean",
          "default": true,
          "description": "Re-render the preview automatically when the file is saved."
        },
        "seraplot.liveType": {
          "type": "boolean",
          "default": true,
          "description": "Re-render the preview as you type (debounced 800 ms). No need to save."
        },
        "seraplot.previewColumn": {
          "type": "string",
          "enum": ["beside", "active", "one", "two", "three"],
          "default": "beside",
          "description": "Where to open the preview when previewMode is 'tab'."
        },
        "seraplot.previewMode": {
          "type": "string",
          "enum": ["panel", "tab", "window"],
          "enumDescriptions": [
            "Render in the bottom panel (movable / resizable, can be docked anywhere inside VS Code).",
            "Render as an editor tab in the chosen column.",
            "Render as a floating native window (detached editor) \u2014 freely draggable & resizable on the desktop."
          ],
          "default": "panel",
          "description": "Where the live preview should be displayed. Cycle on the fly with 'SeraPlot: Switch Preview Mode'."
        },
        "seraplot.previewOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Open the live preview automatically when a Python file is opened."
        },
        "seraplot.autoOpenPreview": {
          "type": "boolean",
          "default": true,
          "description": "Open the live preview automatically the first time you insert a chart from the Studio or Gallery."
        },
        "seraplot.timeout": {
          "type": "number",
          "default": 30000,
          "description": "Maximum time in ms to wait for the preview script to finish."
        },
        "seraplot.defaultPalette": {
          "type": "array",
          "default": ["#6366F1", "#F43F5E", "#10B981", "#F59E0B", "#8B5CF6", "#06B6D4"],
          "description": "Default palette used by the Theme Studio."
        },
        "seraplot.defaultBackground": {
          "type": "string",
          "default": "#0f172a",
          "description": "Default background color used by the Theme Studio."
        },
        "seraplot.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the SeraPlot item in the status bar."
        },
        "seraplot.wheelPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a SeraPlot .whl file. When set, the extension installs it into an isolated cache and uses it instead of the system install. Leave empty to use the user-installed seraplot package."
        },
        "seraplot.wheelCacheDir": {
          "type": "string",
          "default": "",
          "description": "Override location for the per-wheel install cache. Empty = use the extension globalStorage directory."
        },
        "seraplot.wheelAutoReload": {
          "type": "boolean",
          "default": true,
          "description": "Automatically re-install and re-introspect when the active wheel file changes on disk."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo ready",
    "compile": "echo no-ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  }
}
